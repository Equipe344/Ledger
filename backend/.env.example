SECRET_KEY=django-insecure-test-key-for-development-only-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
# Throttle identity behind a reverse proxy. Local dev: 0 (default).
# On Render/production set 1 so rate limits apply per real client IP.
NUM_PROXIES=0
# Explicit frontend origins. Default to local frontend development only.
# Vite dev server runs on 5173 (dept-payments/vite.config.js); port 3000 is
# kept for other tooling. On Render set this to the deployed frontend origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
# Public origin of the deployed SPA (no trailing slash). The backend uses it to
# build the Paystack callback_url so students return to /payment/callback.
# Local default is the Vite dev server; on Render set it to the Vercel URL,
# e.g. FRONTEND_URL=https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173
# Open sign-up. Set False in production once rosters are imported.
ALLOW_SELF_REGISTRATION=True
# Where payment proofs are stored. Leave unset locally (backend/media/);
# in production point it at a persistent disk.
# MEDIA_ROOT=/var/data/media
PAYSTACK_SECRET_KEY=sk_test_dummy_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_dummy_paystack_public_key
# True: Paystack's fee is added to what the student pays online, so the
# department receives the full fee. False: the department absorbs it.
PAYSTACK_PASS_FEE_TO_STUDENT=True

# First-admin bootstrap — read by `python manage.py seed_admin`, which the
# Render build command runs on every deploy. It creates (or repairs) one admin
# and is idempotent; leaving ADMIN_PASSWORD blank makes it skip entirely.
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
# seed_admin also creates this department (if missing) and assigns it to the
# admin, so a fresh deploy can create fees and register students immediately.
ADMIN_DEPARTMENT=Computer Science
ADMIN_FACULTY=Physical Sciences

